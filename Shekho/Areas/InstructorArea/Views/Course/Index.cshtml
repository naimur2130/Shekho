@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<a asp-action="CreateCourse"
   class="btn btn-primary mb-3">
    + Add Course
</a>
<a asp-action="Index" asp-area="InstructorArea" asp-controller="CourseCategory"
   class="btn btn-primary mb-3">
    View Categories
</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Thumbnail</th>
            <th>Title</th>
            <th>Price</th>
            <th>Status</th>
            <th>Published</th> <!-- New column -->
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td>
                    <img src="@course.ThumbnailPath"
                         width="80"
                         class="img-thumbnail" />
                </td>
                <td>@course.CourseTitle</td>
                <td>
                    @(course.IsFree ? "Free" : "$" + course.CoursePrice)
                </td>
                <td>
                    @if (course.IsApproved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">Pending</span>
                    }
                </td>

                <!-- Published column -->
                <td>
                    @if (course.IsPublished)
                    {
                        <span class="badge bg-success">Published</span>
                    }
                    else
                    {
                        <form asp-action="PublishCourse" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@course.CourseId" />
                            <button type="submit" class="btn btn-sm btn-primary">Publish</button>
                        </form>
                    }
                </td>

                <td>
                    <a asp-area="InstructorArea"
                       asp-controller="Module"
                       asp-action="Index"
                       asp-route-courseId="@course.CourseId"
                       class="btn btn-sm btn-info me-2">
                        Sections
                    </a>

                    <a asp-action="EditCourse"
                       asp-route-id="@course.CourseId"
                       class="btn btn-sm btn-warning me-2">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@course.CourseId"
                       class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this course?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
