@model Lesson
@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<style>
    .lesson-card {
        background: #ffffff;
        border-radius: 1rem;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        max-width: 700px;
        margin: 2rem auto;
        transition: all 0.2s ease-in-out;
    }

    .lesson-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 16px 45px rgba(0,0,0,0.12);
    }

    .lesson-card h2 {
        font-weight: 600;
        text-align: center;
        margin-bottom: 1.5rem;
        color: #343a40;
    }

    .form-label {
        font-weight: 500;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 6px rgba(25,135,84,.35);
    }

    .btn-success {
        font-weight: 500;
        padding: 0.6rem 1.2rem;
    }
</style>

<div class="lesson-card">
    <h2>Edit Lesson</h2>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="LessonId" />

        <div class="mb-3">
            <label class="form-label">Lesson Title</label>
            <input asp-for="LessonTitle"
                   class="form-control form-control-lg"
                   placeholder="Enter lesson title" />
            <span asp-validation-for="LessonTitle" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Video URL</label>
            <input asp-for="VideoUrl"
                   class="form-control form-control-lg"
                   placeholder="Paste video URL" />
            <span asp-validation-for="VideoUrl" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Replace Resource (Optional)</label>
            <input type="file"
                   name="Resource"
                   class="form-control form-control-lg" />
            <small class="text-muted">
                Upload only if you want to replace the existing file
            </small>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success w-100">
                <i class="bi bi-check-circle me-2"></i> Update Lesson
            </button>

            <a asp-action="Index"
               asp-route-moduleId="@Model.CourseSectionId"
               class="btn btn-outline-secondary w-100">
                Cancel
            </a>
        </div>
    </form>
</div>
