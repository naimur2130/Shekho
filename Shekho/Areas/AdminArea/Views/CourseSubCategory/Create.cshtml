@model Shekho.Models.CourseSubCategory
@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<style>
    .card-subcategory-create {
        max-width: 500px;
        margin: 2rem auto;
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        padding: 2rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card-subcategory-create:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 40px rgba(0,0,0,0.15);
    }

    .card-subcategory-create h2 {
        font-weight: 600;
        color: #17a2b8;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .btn-success {
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }

    .btn-secondary {
        margin-left: 0.5rem;
    }

</style>

<div class="card card-subcategory-create">
    <h2>Create Subcategory</h2>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="CategoryId" value="@ViewBag.CategoryId" />

        <div class="mb-3">
            <label asp-for="SubCategoryName" class="form-label">Subcategory Name</label>
            <input asp-for="SubCategoryName" class="form-control form-control-lg" placeholder="Enter subcategory name" />
            <span asp-validation-for="SubCategoryName" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success w-50">
                <i class="bi bi-save me-1"></i> Save
            </button>
            <a asp-action="Index"
               asp-route-categoryId="@ViewBag.CategoryId"
               class="btn btn-secondary w-50 text-center">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </form>
</div>
