@model IEnumerable<Shekho.Models.CourseSubCategory>
@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<style>
    .card-subcategory-list {
        border-radius: 1rem;
        background: #fff;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        transition: transform 0.2s, box-shadow 0.2s;
        margin: 2rem auto;
        padding: 1.5rem;
        max-width: 800px;
    }

    .card-subcategory-list:hover {
        transform: translateY(-3px);
        box-shadow: 0 14px 40px rgba(0,0,0,0.15);
    }

    .card-subcategory-list h2 {
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #17a2b8;
    }

    .btn-primary {
        font-weight: 600;
        transition: all 0.2s;
    }

    .btn-primary:hover {
        background-color: #138496;
        border-color: #117a8b;
    }

    table th {
        background-color: #f8f9fa;
        font-weight: 600;
    }

    table td {
        vertical-align: middle;
    }

</style>

<div class="card card-subcategory-list">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Subcategories of @ViewBag.CategoryName</h2>
        <a asp-action="Create"
           asp-route-categoryId="@ViewBag.CategoryId"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Subcategory
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered mb-0">
            <thead>
                <tr>
                    <th>Subcategory Name</th>
                    <th style="width: 120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model)
                {
                    <tr>
                        <td>@sub.SubCategoryName</td>
                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@sub.SubCategoryId"
                               class="btn btn-warning btn-sm me-1">
                               <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete"
                               asp-route-id="@sub.SubCategoryId"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Are you sure you want to delete this subcategory?');">
                               <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
