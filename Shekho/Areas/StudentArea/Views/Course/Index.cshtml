@model Shekho.ViewModels.CourseBrowsingViewModel
@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<h2>Browse Courses</h2>

<form method="get" class="mb-3">
    <div class="row g-2">

        <!-- Category Filter -->
<div class="col-md-3">
    <select class="form-select"
            id="categorySelect"
            name="categoryId">
        <option value="">All Categories</option>
        @foreach (var cat in Model.Categories)
        {
            <option value="@cat.CategoryId"
                    selected="@(Model.SelectedCategoryId == cat.CategoryId)">
                @cat.CategoryName
            </option>
        }
    </select>
</div>

<!-- SubCategory Filter -->
<div class="col-md-3">
    <select class="form-select"
            id="subCategorySelect"
            name="subCategoryId">
        <option value="">All SubCategories</option>
        @foreach (var sub in Model.SubCategories)
        {
            <option value="@sub.SubCategoryId"
                    selected="@(Model.SelectedSubCategoryId == sub.SubCategoryId)">
                @sub.SubCategoryName
            </option>
        }
    </select>
</div>


        <!-- Difficulty Filter -->
        <div class="col-md-2">
            <select class="form-select" name="difficulty">
                <option value="">All Levels</option>

                <option value="Beginner"
                        selected="@(Model.SelectedDifficulty == Shekho.Models.DifficultyLevel.Beginner)">
                    Beginner
                </option>

                <option value="Intermediate"
                        selected="@(Model.SelectedDifficulty == Shekho.Models.DifficultyLevel.Intermediate)">
                    Intermediate
                </option>

                <option value="Advance"
                        selected="@(Model.SelectedDifficulty == Shekho.Models.DifficultyLevel.Advance)">
                    Advanced
                </option>
            </select>
        </div>

        <!-- Search -->
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   name="searchTerm"
                   placeholder="Search courses..."
                   value="@Model.SearchTerm" />
        </div>

        <div class="col-md-12 mt-2">
            <button type="submit" class="btn btn-primary">
                Apply Filters
            </button>
        </div>

    </div>
</form>

<hr />

<div class="row row-cols-1 row-cols-md-3 g-4 mt-2">
    @foreach (var course in Model.Courses)
    {
        <div class="col">
            <div class="card h-100">
                <img src="@course.ThumbnailPath"
                     class="card-img-top"
                     alt="@course.CourseTitle" />

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@course.CourseTitle</h5>

                    <p class="card-text">
                        @course.Category?.CategoryName /
                        @course.SubCategory?.SubCategoryName <br />
                        Level: @course.DifficultyLevel <br />
                        Price: @(course.IsFree ? "Free" : "$" + course.CoursePrice)
                    </p>

                    <div class="mt-auto d-flex justify-content-between">
                        <!-- View Course -->
                        <a asp-area="StudentArea"
                           asp-controller="Course"
                           asp-action="Details"
                           asp-route-id="@course.CourseId"
                           class="btn btn-sm btn-outline-primary">
                            View
                        </a>

                        <!-- Enroll Button -->
                        <a asp-area="StudentArea"
                           asp-controller="Enrollment"
                           asp-action="Enroll"
                           asp-route-courseId="@course.CourseId"
                           class="btn btn-sm btn-success">
                            Enroll
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@section Scripts {
<script>
    const categorySelect = document.getElementById("categorySelect");
    const subSelect = document.getElementById("subCategorySelect");

    function loadSubCategories(categoryId, selectedSubCategoryId = null) {
        subSelect.innerHTML = '<option value="">All SubCategories</option>';

        if (!categoryId) return;

        fetch(`/StudentArea/Course/GetByCategory?categoryId=${categoryId}`)
            .then(res => res.json())
            .then(data => {
                data.forEach(sub => {
                    const option = document.createElement("option");
                    option.value = sub.subCategoryId;
                    option.textContent = sub.subCategoryName;

                    if (selectedSubCategoryId &&
                        selectedSubCategoryId == sub.subCategoryId) {
                        option.selected = true;
                    }

                    subSelect.appendChild(option);
                });
            });
    }

    // Change event
    categorySelect.addEventListener("change", function () {
        loadSubCategories(this.value);
    });

    // 🔥 AUTO LOAD on page refresh
    const selectedCategoryId = "@Model.SelectedCategoryId";
    const selectedSubCategoryId = "@Model.SelectedSubCategoryId";

    if (selectedCategoryId) {
        loadSubCategories(selectedCategoryId, selectedSubCategoryId);
    }
</script>
}


