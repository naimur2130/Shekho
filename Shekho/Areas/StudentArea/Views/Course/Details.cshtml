@model Shekho.Models.Course
@{
    Layout = "~/Views/Shared/_AdminPage.cshtml";
}

<div class="container mt-4">

    <div class="row">
        <div class="col-md-8">
            <h2>@Model.CourseTitle</h2>

            <p class="text-muted">
                @Model.Category?.CategoryName /
                @Model.SubCategory?.SubCategoryName
            </p>

            <p>
                <strong>Difficulty:</strong> @Model.DifficultyLevel
            </p>

            <p>
                <strong>Price:</strong>
                @(Model.IsFree ? "Free" : "$" + Model.CoursePrice)
            </p>

            <hr />

            <h5>Description</h5>
            <p>@Model.CourseDescription</p>

            <hr />

            <h5>Course Content</h5>

            @foreach (var sec in Model.courseSections.OrderBy(s => s.Order))
            {
                <div class="mb-3">
                    <h6>@sec.CourseSectionName</h6>

                    <ul class="list-group">
                        @foreach (var lesson in sec.Lesson.OrderBy(l => l.Order))
                        {
                            <li class="list-group-item">
                                🔒 @lesson.LessonTitle
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <img src="@Model.ThumbnailPath" class="card-img-top" />

                <div class="card-body text-center">
                    <h4>
                        @(Model.IsFree ? "Free" : "$" + Model.CoursePrice)
                    </h4>

                    <a asp-area="StudentArea"
                       asp-controller="Enrollment"
                       asp-action="Enroll"
                       asp-route-courseId="@Model.CourseId"
                       class="btn btn-success w-100 mt-2">
                        Enroll Now
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
