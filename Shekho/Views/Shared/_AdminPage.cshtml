<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>My Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- OverlayScrollbars -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/styles/overlayscrollbars.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- DataTables -->
    <link href="~/datatable/datatables.min.css" rel="stylesheet" />

    <!-- AdminLTE -->
    <link rel="stylesheet" href="../../../dist/css/adminlte.css" />

    <style>
        /* === Body & App Wrapper === */
        body, .app-wrapper {
            background: #f4f7f9; /* light gray-blue */
            color: #333;
            font-family: "Segoe UI", sans-serif;
            min-height: 100vh;
            transition: background 0.5s ease;
        }

        /* === Navbar === */
        .navbar {
            background: #2c3e50; /* dark slate blue */
        }
        .navbar .nav-link {
            color: #ecf0f1; /* light gray text */
            border-radius: 6px;
            padding: 0.5rem 1rem;
            transition: all 0.3s ease;
        }
        .navbar .nav-link:hover {
            background: #1abc9c; /* teal highlight */
            color: #fff;
        }
        .navbar .bi-arrows-fullscreen,
        .navbar .bi-fullscreen-exit {
            color: #ecf0f1;
            font-size: 1.2rem;
            transition: color 0.3s ease;
        }
        .navbar .bi-arrows-fullscreen:hover,
        .navbar .bi-fullscreen-exit:hover {
            color: #1abc9c;
        }

        /* === Sidebar === */
        .sidebar-dark, .app-sidebar {
            background: #34495e; /* slate gray */
            color: #ecf0f1;
        }
        .sidebar-dark .nav-link {
            color: #ecf0f1;
            border-radius: 6px;
            transition: all 0.3s ease;
        }
        .sidebar-dark .nav-link:hover {
            background: #1abc9c;
            color: #fff;
        }
        .sidebar-dark .nav-link.active {
            background: #16a085;
            color: #fff;
            box-shadow: 0 0 12px rgba(26, 188, 156, 0.5);
        }
        .sidebar-dark .nav-icon,
        .sidebar-dark .nav-arrow {
            color: #ecf0f1;
        }

        /* === Main Content === */
        main {
            padding: 1.5rem;
            background: #ffffff; /* clean white content area */
            border-radius: 12px;
            box-shadow: 0 0 20px rgba(0,0,0,0.05);
        }

        /* === Footer === */
        .app-footer {
            background: #2c3e50;
            color: #ecf0f1;
            border-top: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s;
        }
        .app-footer a {
            color: #1abc9c;
            text-decoration: none;
            transition: color 0.3s;
        }
        .app-footer a:hover {
            color: #16a085;
        }

        /* === Buttons === */
        button.btn-primary {
            background: #1abc9c;
            border: none;
            color: #fff;
            font-weight: bold;
            transition: all 0.3s;
        }
        button.btn-primary:hover {
            background: #16a085;
        }

        /* === DataTables Styling === */
        table.dataTable thead {
            background: #1abc9c;
            color: #fff;
        }
        table.dataTable tbody tr:hover {
            background: rgba(26,188,156,0.1);
        }

        /* === Scrollbar Styling === */
        .os-theme-dark>.os-scrollbar>.os-scrollbar-track>.os-scrollbar-handle {
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
        }
    </style>
</head>
<body class="layout-fixed sidebar-expand-lg">

<div class="app-wrapper">

    <!-- Navbar -->
    <nav class="navbar navbar-expand shadow-sm">
        <div class="container-fluid">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-lte-toggle="sidebar" href="#">
                        <i class="bi bi-list"></i>
                    </a>
                </li>
                @if (!User.Identity!.IsAuthenticated)
{
    <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
    </li>
    <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-controller="Home" asp-action="OurService">Our Services</a>
    </li>
    <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
    </li>
}
else
{
    <li class="nav-item d-none d-md-block">
        @if (User.IsInRole("Admin"))
        {
            <a class="nav-link" asp-area="AdminArea" asp-controller="Admin" asp-action="Dashboard">Home</a>
        }
        else if (User.IsInRole("Instructor"))
        {
            <a class="nav-link" asp-area="InstructorArea" asp-controller="Instructor" asp-action="Index">Home</a>
                <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurService">Our Services</a>
    </li>
    <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
    </li>
        }
        else if (User.IsInRole("Student"))
        {
            <a class="nav-link" asp-area="StudentArea" asp-controller="Course" asp-action="Index">Home</a>
                <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="OurService">Our Services</a>
    </li>
    <li class="nav-item d-none d-md-block">
        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
    </li>
        }
        else
        {
            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
        }
    </li>
}
            </ul>

            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                        <i class="bi bi-arrows-fullscreen"></i>
                        <i class="bi bi-fullscreen-exit" style="display: none"></i>
                    </a>
                </li>
                <partial name="_LoginPartial.cshtml" />
            </ul>
        </div>
    </nav>

    <!-- Sidebar -->
    <partial name="_SideBar.cshtml" />

    <!-- Main Content -->
    <main role="main" class="pb-3 container-fluid mt-3">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="app-footer text-center py-3 mt-auto">
        <div class="float-end d-none d-sm-inline text-white-50">Anything you want</div>
        <strong>
            &copy; 2014-2025 <a href="https://adminlte.io">AdminLTE.io</a>
        </strong> All rights reserved.
    </footer>

</div>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/datatable/datatables.min.js"></script>
<script src="~/js/site.js"></script>
<script src="../../../dist/js/adminlte.js"></script>
<script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/browser/overlayscrollbars.browser.es6.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarWrapper = document.querySelector('.sidebar-wrapper');
        if (sidebarWrapper && OverlayScrollbarsGlobal?.OverlayScrollbars !== undefined) {
            OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
                scrollbars: { theme: 'os-theme-dark', autoHide: 'leave', clickScroll: true },
            });
        }
    });
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
