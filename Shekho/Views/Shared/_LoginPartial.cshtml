@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!-- Page-specific CSS -->
<style>
    /* Navbar Links */
    .navbar-nav .nav-link {
        color: #ddd; /* light gray text */
        transition: color 0.3s ease, background 0.3s ease;
        padding: 0.4rem 0.8rem;
        border-radius: 5px;
    }

    .navbar-nav .nav-link:hover {
        color: #1E90FF; /* blue hover */
        background-color: rgba(138, 43, 226, 0.2); /* violet subtle background */
    }

    .navbar-nav .nav-link.btn-link {
        color: #ddd;
        padding: 0.4rem 0.8rem;
        font-weight: 500;
    }

    .navbar-nav .nav-link.btn-link:hover {
        color: #FF69B4; /* pinkish hover for buttons (optional accent) */
        background-color: rgba(138, 43, 226, 0.2);
    }

    .navbar-nav .nav-item + .nav-item {
        margin-left: 0.5rem;
    }
</style>

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Profile" asp-action="Index" title="Manage">
            Hello <span class="text-violet">@User.Identity?.Name!</span>
        </a>
    </li>

    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" 
              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
